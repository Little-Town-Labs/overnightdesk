{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://overnightdesk.com/schemas/meeting-brief-v1.json",
  "title": "Titus Meeting Brief v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "occurredAt",
    "participants",
    "summary",
    "facts",
    "decisions",
    "actionItems",
    "externalCommitments",
    "unresolvedQuestions",
    "proposedFollowUp",
    "projectHint",
    "projectConfidence"
  ],
  "properties": {
    "schemaVersion": { "const": "meeting-brief/v1" },
    "title": { "$ref": "#/$defs/shortText" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "participants": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "facts": { "$ref": "#/$defs/statements" },
    "decisions": { "$ref": "#/$defs/statements" },
    "actionItems": {
      "type": "array",
      "maxItems": 25,
      "items": { "$ref": "#/$defs/actionItem" }
    },
    "externalCommitments": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/commitment" }
    },
    "unresolvedQuestions": { "$ref": "#/$defs/statements" },
    "proposedFollowUp": { "type": "string", "maxLength": 2000 },
    "projectHint": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "minLength": 1, "maxLength": 100 }
      ]
    },
    "projectConfidence": {
      "enum": ["unknown", "low", "medium", "high"]
    }
  },
  "$defs": {
    "shortText": { "type": "string", "minLength": 1, "maxLength": 120 },
    "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
    "statements": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/statement" }
    },
    "sourceTimestamp": {
      "type": "string",
      "pattern": "^(?:[0-9]{2,}:)?[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{3})?$"
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "actionItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "owner", "dueDate", "sourceTimestamp", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "owner": { "enum": ["gary", "austin", "unassigned"] },
        "dueDate": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date" }
          ]
        },
        "sourceTimestamp": { "$ref": "#/$defs/sourceTimestamp" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "dueDate", "sourceTimestamp", "confidence"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "dueDate": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date" }
          ]
        },
        "sourceTimestamp": { "$ref": "#/$defs/sourceTimestamp" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
