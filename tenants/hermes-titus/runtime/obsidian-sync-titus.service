[Unit]
Description=OvernightDesk Titus Obsidian Headless Sync sidecar
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/hermes-titus/obsidian-project-knowledge-enabled
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=simple
User=hermes-titus
Group=hermes-titus
SupplementaryGroups=docker
RuntimeDirectory=obsidian-sync-titus
RuntimeDirectoryMode=0750
ExecStartPre=+/opt/hermes-titus/bin/load-obsidian-sync-env.sh
ExecStart=/opt/hermes-titus/bin/run-obsidian-sync.sh
ExecStop=+/opt/hermes-titus/bin/stop-obsidian-sync.sh
Restart=on-failure
RestartSec=30
TimeoutStartSec=120
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/obsidian-sync-titus

[Install]
WantedBy=multi-user.target
