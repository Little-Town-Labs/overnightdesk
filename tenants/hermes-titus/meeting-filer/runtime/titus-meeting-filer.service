[Unit]
Description=OvernightDesk approved meeting brief filer
Requires=docker.service
After=docker.service network-online.target hermes-titus.service
Wants=network-online.target

[Service]
Type=simple
User=titus-meeting-filer
Group=titus-meeting-filer
SupplementaryGroups=docker
ExecStartPre=+/opt/titus-meeting-filer/bin/load-phase-config.sh
ExecStartPre=+/opt/titus-meeting-filer/bin/prepare-volumes.sh
ExecStart=/opt/titus-meeting-filer/bin/run-container.sh
ExecStop=+/opt/titus-meeting-filer/bin/stop-container.sh
Restart=always
RestartSec=10
TimeoutStartSec=300
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/titus-meeting-filer

[Install]
WantedBy=multi-user.target
