{
  "name": "overnightdesk-eve-practice-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "auth:login": "node scripts/practice-command.mjs auth:login",
    "auth:logout": "node scripts/practice-command.mjs auth:logout",
    "auth:status": "node scripts/practice-command.mjs auth:status",
    "build:mock": "EVE_PRACTICE_MODEL=mock eve build",
    "check": "npm run typecheck && npm test && npm run info:mock && npm run build:mock && npm run eval:mock",
    "dev": "node scripts/practice-command.mjs dev",
    "eval:mock": "EVE_PRACTICE_MODEL=mock eve eval --strict --skip-report",
    "info:mock": "node scripts/verify-surface.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ai": "7.0.82",
    "eve": "0.51.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
